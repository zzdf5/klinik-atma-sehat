@startuml Class Diagram - Klinik Atma Sehat

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam packageStyle rectangle
skinparam packageBackgroundColor White
skinparam packageBorderColor #AAAAAA
skinparam packageFontStyle Italic
skinparam classBackgroundColor White
skinparam classBorderColor #555555
skinparam arrowColor #333333
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70

' =====================================================================
' PACKAGE: PENGGUNA
' =====================================================================

package "Pengguna" {

  abstract class Pengguna {
    - id : String
    - nama : String
    - noTelepon : String
    - username : String
    - password : String
    ..
    + setId(String) : void
    + setNama(String) : void
    + setNoTelepon(String) : void
    + setUsername(String) : void
    + setPassword(String) : void
    ..
    + getId() : String
    + getNama() : String
    + getNoTelepon() : String
    + getUsername() : String
    + getPassword() : String
    ..
    + getInfo() : String
    + {abstract} getPeran() : String
  }

  class Dokter {
    - nomorSTR : String
    - spesialisasi : String
    - tarifKonsultasi : double
    - statusAktif : boolean
    ..
    + setNomorSTR(String) : void
    + setSpesialisasi(String) : void
    + setTarifKonsultasi(double) : void
    + setStatusAktif(boolean) : void
    ..
    + getNomorSTR() : String
    + getSpesialisasi() : String
    + getTarifKonsultasi() : double
    + isStatusAktif() : boolean
    + getInfo() : String
    + getPeran() : String
  }

  class Admin {
    - statusAktif : boolean
    - jabatan : Jabatan
    ..
    + setStatusAktif(boolean) : void
    + setJabatan(Jabatan) : void
    ..
    + isStatusAktif() : boolean
    + getJabatan() : Jabatan
    + getPeran() : String
  }

  enum "Admin.Jabatan" as AdminJabatan {
    KARYAWAN
    MANAGER
  }

  Pengguna <|-- Dokter
  Pengguna <|-- Admin
  Admin ..> AdminJabatan
}

' =====================================================================
' PACKAGE: PASIEN
' =====================================================================

package "Pasien" {

  class Pasien {
    - id : String
    - nomorRekamMedis : String
    - nama : String
    - tanggalLahir : String
    - jenisKelamin : String
    - noTelepon : String
    - alamat : String
    ..
    + setId(String) : void
    + setNomorRekamMedis(String) : void
    + setNama(String) : void
    + setTanggalLahir(String) : void
    + setJenisKelamin(String) : void
    + setNoTelepon(String) : void
    + setAlamat(String) : void
    ..
    + getId() : String
    + getNomorRekamMedis() : String
    + getNama() : String
    + getTanggalLahir() : String
    + getJenisKelamin() : String
    + getNoTelepon() : String
    + getAlamat() : String
    + getInfo() : String
  }

  class RekamMedis {
    - nomorRekamMedis : String
    - idPasien : String
    - tanggalBuat : String
    - alergi : List<String>
    - riwayatPenyakit : List<String>
    ..
    + setNomorRekamMedis(String) : void
    + setIdPasien(String) : void
    + setTanggalBuat(String) : void
    ..
    + getNomorRekamMedis() : String
    + getIdPasien() : String
    + getTanggalBuat() : String
    + getAlergi() : List<String>
    + getRiwayatPenyakit() : List<String>
    ..
    + tambahAlergi(String) : void
    + tambahRiwayatPenyakit(String) : void
    + getInfo() : String
  }

  Pasien "1" -- "1" RekamMedis : memiliki
}

' =====================================================================
' PACKAGE: OPERASIONAL
' =====================================================================

package "Operasional" {

  class Poliklinik {
    - idPoliklinik : String
    - namaPoliklinik : String
    - lokasiRuangan : String
    - jamOperasional : String
    ..
    + setIdPoliklinik(String) : void
    + setNamaPoliklinik(String) : void
    + setLokasiRuangan(String) : void
    + setJamOperasional(String) : void
    ..
    + getIdPoliklinik() : String
    + getNamaPoliklinik() : String
    + getLokasiRuangan() : String
    + getJamOperasional() : String
    + getInfo() : String
  }

  class JadwalDokter {
    - idJadwal : String
    - idDokter : String
    - idPoliklinik : String
    - jamMulai : String
    - jamSelesai : String
    - kuotaPasien : int
    ..
    + setIdJadwal(String) : void
    + setIdDokter(String) : void
    + setIdPoliklinik(String) : void
    + setJamMulai(String) : void
    + setJamSelesai(String) : void
    + setKuotaPasien(int) : void
    ..
    + getIdJadwal() : String
    + getIdDokter() : String
    + getIdPoliklinik() : String
    + getJamMulai() : String
    + getJamSelesai() : String
    + getKuotaPasien() : int
    + getInfo() : String
  }

  class Antrian {
    - idAntrian : String
    - nomorUrut : String
    - idPasien : String
    - idDokter : String
    - idPoliklinik : String
    - tanggal : String
    - status : Status
    - jenisKunjungan : JenisKunjungan
    ..
    + setIdAntrian(String) : void
    + setNomorUrut(String) : void
    + setIdPasien(String) : void
    + setIdDokter(String) : void
    + setIdPoliklinik(String) : void
    + setTanggal(String) : void
    + setStatus(Status) : void
    + setJenisKunjungan(JenisKunjungan) : void
    ..
    + getIdAntrian() : String
    + getNomorUrut() : String
    + getIdPasien() : String
    + getIdDokter() : String
    + getIdPoliklinik() : String
    + getTanggal() : String
    + getStatus() : Status
    + getJenisKunjungan() : JenisKunjungan
    + getInfo() : String
  }

  enum "Antrian.Status" as AntrianStatus {
    MENUNGGU
    DALAM_PEMERIKSAAN
    SELESAI
    BATAL
  }

  enum "Antrian.JenisKunjungan" as AntrianJenis {
    BARU
    KONTROL
    RUJUKAN
  }

  Antrian ..> AntrianStatus
  Antrian ..> AntrianJenis
  Poliklinik "1" -- "0..*" JadwalDokter : memiliki
}

' =====================================================================
' PACKAGE: KUNJUNGAN
' =====================================================================

package "Kunjungan" {

  class Kunjungan {
    - idKunjungan : String
    - nomorRekamMedis : String
    - idDokter : String
    - tanggal : String
    - jam : String
    - keluhanUtama : String
    - hasilPemeriksaan : String
    - idDiagnosa : String
    - idResep : String
    - biayaKonsultasi : double
    - status : Status
    ..
    + setIdKunjungan(String) : void
    + setNomorRekamMedis(String) : void
    + setIdDokter(String) : void
    + setTanggal(String) : void
    + setJam(String) : void
    + setKeluhanUtama(String) : void
    + setHasilPemeriksaan(String) : void
    + setIdDiagnosa(String) : void
    + setIdResep(String) : void
    + setBiayaKonsultasi(double) : void
    + setStatus(Status) : void
    ..
    + getIdKunjungan() : String
    + getNomorRekamMedis() : String
    + getIdDokter() : String
    + getTanggal() : String
    + getJam() : String
    + getKeluhanUtama() : String
    + getHasilPemeriksaan() : String
    + getIdDiagnosa() : String
    + getIdResep() : String
    + getBiayaKonsultasi() : double
    + getStatus() : Status
    + getInfo() : String
  }

  enum "Kunjungan.Status" as KunjunganStatus {
    BELUM_DILAKUKAN
    SELESAI
    BATAL
  }

  class Diagnosa {
    - idDiagnosa : String
    - kodePenyakit : String
    - namaPenyakit : String
    - keterangan : String
    - tanggalDiagnosa : String
    - perluRujukan : boolean
    ..
    + setIdDiagnosa(String) : void
    + setKodePenyakit(String) : void
    + setNamaPenyakit(String) : void
    + setKeterangan(String) : void
    + setTanggalDiagnosa(String) : void
    + setPerluRujukan(boolean) : void
    ..
    + getIdDiagnosa() : String
    + getKodePenyakit() : String
    + getNamaPenyakit() : String
    + getKeterangan() : String
    + getTanggalDiagnosa() : String
    + isPerluRujukan() : boolean
    + getInfo() : String
  }

  Kunjungan ..> KunjunganStatus
  Kunjungan "1" -- "0..1" Diagnosa : menghasilkan
}

' =====================================================================
' PACKAGE: FARMASI
' =====================================================================

package "Farmasi" {

  class Obat {
    - idObat : String
    - namaObat : String
    - bentukSediaan : String
    - dosis : String
    - kategori : String
    - hargaSatuan : double
    - stok : int
    ..
    + setIdObat(String) : void
    + setNamaObat(String) : void
    + setBentukSediaan(String) : void
    + setDosis(String) : void
    + setKategori(String) : void
    + setHargaSatuan(double) : void
    + setStok(int) : void
    ..
    + getIdObat() : String
    + getNamaObat() : String
    + getBentukSediaan() : String
    + getDosis() : String
    + getKategori() : String
    + getHargaSatuan() : double
    + getStok() : int
    ..
    + getInfo() : String
  }

  class Resep {
    - idResep : String
    - idDokter : String
    - nomorRekamMedis : String
    - tanggalResep : String
    - status : Status
    - daftarObat : List<ItemResep>
    ..
    + setIdResep(String) : void
    + setIdDokter(String) : void
    + setNomorRekamMedis(String) : void
    + setTanggalResep(String) : void
    + setStatus(Status) : void
    ..
    + getIdResep() : String
    + getIdDokter() : String
    + getNomorRekamMedis() : String
    + getTanggalResep() : String
    + getStatus() : Status
    + getDaftarObat() : List<ItemResep>
    ..
    + tambahObat(ItemResep) : void
    + getInfo() : String
  }

  enum "Resep.Status" as ResepStatus {
    DIPROSES
    SELESAI
    BATAL
  }

  class "Resep.ItemResep" as ItemResep {
    - obat : Obat
    - jumlah : int
    - aturanPakai : String
    ..
    + setObat(Obat) : void
    + setJumlah(int) : void
    + setAturanPakai(String) : void
    ..
    + getObat() : Obat
    + getJumlah() : int
    + getAturanPakai() : String
    + getNamaObat() : String
    + getHarga() : double
  }

  Resep ..> ResepStatus
  Resep "1" *-- "1..*" ItemResep : berisi
  ItemResep "*" --> "1" Obat : menggunakan
}

' =====================================================================
' PACKAGE: ADMINISTRASI
' =====================================================================

package "Administrasi" {

  class Tagihan {
    - idTagihan : String
    - idKunjungan : String
    - tanggalTagihan : String
    - totalTagihan : double
    - jumlahBayar : double
    - kembalian : double
    - metodePembayaran : MetodePembayaran
    - status : Status
    - daftarItem : List<ItemTagihan>
    ..
    + setIdTagihan(String) : void
    + setIdKunjungan(String) : void
    + setTanggalTagihan(String) : void
    + setMetodePembayaran(MetodePembayaran) : void
    + setStatus(Status) : void
    ..
    + getIdTagihan() : String
    + getIdKunjungan() : String
    + getTanggalTagihan() : String
    + getTotalTagihan() : double
    + getJumlahBayar() : double
    + getKembalian() : double
    + getMetodePembayaran() : MetodePembayaran
    + getStatus() : Status
    + getDaftarItem() : List<ItemTagihan>
    ..
    + tambahItem(ItemTagihan) : void
    + getInfo() : String
  }

  enum "Tagihan.MetodePembayaran" as MetodeBayar {
    TUNAI
    BPJS
    TRANSFER
    DEBIT
  }

  enum "Tagihan.Status" as TagihanStatus {
    BELUM_BAYAR
    LUNAS
  }

  class "Tagihan.ItemTagihan" as ItemTagihan {
    - namaItem : String
    - jumlah : int
    - hargaSatuan : double
    ..
    + setNamaItem(String) : void
    + setJumlah(int) : void
    + setHargaSatuan(double) : void
    ..
    + getNamaItem() : String
    + getJumlah() : int
    + getHargaSatuan() : double
  }

  class Rujukan {
    - idRujukan : String
    - idKunjungan : String
    - nomorRekamMedis : String
    - idDokterPengirim : String
    - tujuanRujukan : String
    - alasanRujukan : String
    - tanggalRujukan : String
    - tanggalBerlaku : String
    - status : Status
    ..
    + setIdRujukan(String) : void
    + setTujuanRujukan(String) : void
    + setAlasanRujukan(String) : void
    + setTanggalBerlaku(String) : void
    + setStatus(Status) : void
    ..
    + getIdRujukan() : String
    + getIdKunjungan() : String
    + getNomorRekamMedis() : String
    + getIdDokterPengirim() : String
    + getTujuanRujukan() : String
    + getAlasanRujukan() : String
    + getTanggalRujukan() : String
    + getTanggalBerlaku() : String
    + getStatus() : Status
    + getInfo() : String
  }

  enum "Rujukan.Status" as RujukanStatus {
    AKTIF
    DIGUNAKAN
    BATAL
  }

  Tagihan ..> MetodeBayar
  Tagihan ..> TagihanStatus
  Tagihan "1" *-- "1..*" ItemTagihan : berisi
  Rujukan ..> RujukanStatus
}

' =====================================================================
' RELASI ANTAR PACKAGE
' =====================================================================

Dokter      "1" -- "0..*" JadwalDokter  : memiliki jadwal
Dokter      "1" -- "0..*" Antrian       : melayani
Poliklinik  "1" -- "0..*" Antrian       : tempat
Pasien      "1" -- "0..*" Antrian       : mendaftar
RekamMedis  "1" -- "0..*" Kunjungan     : mencatat
Dokter      "1" -- "0..*" Kunjungan     : menangani
Kunjungan   "1" -- "0..1" Resep         : menghasilkan
Kunjungan   "1" -- "0..1" Tagihan       : menghasilkan
Kunjungan   "1" -- "0..1" Rujukan       : menghasilkan

@enduml
